{{- $p := includeTemplate "platform.json" . | fromJson -}}

alias py='python3'
alias home='cd ~'
alias ..='cd ..'
alias lzd='lazydocker'
alias neofetch='fastfetch'
alias cat='bat -p'
alias df='duf'
alias g='lazygit'

alias ls='eza --color=auto --group-directories-first --icons=auto'
alias ll='eza -l --color=auto --group-directories-first --icons=auto'
alias la='eza -la --color=auto --group-directories-first --icons=auto'

{{- if or $p.isDarwin $p.isWSL }}
alias v='nvim'
{{- else if $p.isNixOS }}
alias v='hx'
{{- else }}
alias v='nvim'
{{- end }}

{{- if $p.isNixOS }}
{{- if and $p.isWSL (index . "gpg_enabled") }}
# rebuild restarts gpg-agent, which forgets the tty
alias update='sudo nixos-rebuild switch --flake .# && gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1'
alias upgrade='nix flake update && sudo nixos-rebuild switch --flake .# && gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1'
alias rollback='sudo nixos-rebuild switch --flake .# --rollback && gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1'
{{- else }}
alias update='sudo nixos-rebuild switch --flake .#'
alias upgrade='nix flake update && sudo nixos-rebuild switch --flake .#'
alias rollback='sudo nixos-rebuild switch --flake .# --rollback'
{{- end }}
alias update-boot='sudo nixos-rebuild boot --flake .#'
alias check='sudo nixos-rebuild dry-run --flake .#'
alias nix-clean='sudo nix-collect-garbage -d && nix-collect-garbage -d'
alias nix-info='nixos-version && nix --version'
alias nix-gen='sudo nix-env --list-generations --profile /nix/var/nix/profiles/system'
{{- end }}

{{- if $p.isDarwin }}
alias bbedit='brew bundle edit --global'
alias bbinstall='brew bundle install --global'
alias bbclean='brew bundle --global --cleanup'
alias bbcheck='brew bundle check --global'
alias bbupgrade='brew update && brew upgrade && brew bundle install --global --upgrade'
alias doc='cd ~/Documents/'
{{- end }}

{{- if $p.isWSL }}
alias copy='clip.exe'
{{- end }}
