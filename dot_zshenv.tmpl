{{- $p := includeTemplate "platform.json" . | fromJson -}}
# ── .zshenv ───────────────────────────────────────────────────────────────────
# Sourced by *every* zsh: interactive, login, scripts, git hooks, `ssh host cmd`
# and GUI-launched processes. Environment and PATH live here so they are not
# limited to interactive shells.
#
# Anything that runs a command, writes output, or touches the terminal must NOT
# go here — it would run for every script too. That belongs in ~/.zsh/conf.d/.
#
# This file replaces the one rustup writes (which only sources ~/.cargo/env to
# prepend ~/.cargo/bin); that path is folded into the PATH lists below.

# Dedupe PATH, so re-sourcing reorders instead of appending another copy.
# -x is explicit: if zsh started with no PATH in the environment at all
# (launchd, cron), a bare `typeset -U` would leave PATH unexported and every
# child process would get an empty PATH.
typeset -gxU path PATH

export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Catppuccin Mocha colors — https://github.com/catppuccin/fzf
export FZF_DEFAULT_OPTS="\
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
--color=selected-bg:#45475a \
--color=border:#313244,label:#cdd6f4"

{{- if $p.isDarwin }}

export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_BUNDLE_NO_UPGRADE=1
export DOCKER_HOST="unix://$HOME/.colima/default/docker.sock"

path=("$HOMEBREW_PREFIX/bin" "$HOMEBREW_PREFIX/sbin" $path)
path+=("$HOME/.cargo/bin" "$HOME/go/bin" "$HOME/.my-scripts/bin")

export EDITOR="nvim"
{{- else if $p.isLinux }}

path+=(
  "$HOME/.local/bin"
  "$HOME/.cargo/bin"
  "$HOME/go/bin"
  "$HOME/.my-scripts/bin"
)

{{- if $p.isNixOS }}
export EDITOR="hx"
{{- else }}
export EDITOR="nvim"
{{- end }}
{{- end }}

{{- if and (not $p.isNixOS) (not $p.isWindows) }}

# Point neovim to the nvim/ subdirectory inside the cloned repo
export NVIM_APPNAME="neovim-config/nvim"
{{- end }}
