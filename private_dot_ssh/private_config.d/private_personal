# Keys: `ssh-keygen -K` with the YubiKey. No ControlMaster: one touch per connection.

Host github.com codeberg.org
  IdentityFile ~/.ssh/id_ed25519_sk_rk_git
  IdentityAgent none
  IdentitiesOnly yes

# Forgejo has its own SSH server
Host git.jeomhps.com
  Port 2223
  User git
  IdentityFile ~/.ssh/id_ed25519_sk_rk_git
  IdentityAgent none
  IdentitiesOnly yes

Host vps
  HostName vps.jeomhps.com
  Port 2222
  User admin
  IdentityFile ~/.ssh/id_ed25519_sk_rk_vps
  IdentityAgent none
  IdentitiesOnly yes
