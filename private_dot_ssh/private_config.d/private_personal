# Keys: `ssh-keygen -K` with the YubiKey. No ControlMaster: one touch per connection.

Host github.com
  IdentityFile ~/.ssh/id_ed25519_sk_rk_github
  IdentityAgent none
  IdentitiesOnly yes

# Forgejo has its own SSH server
Host git.jeomhps.com
  Port 2223
  User git
  IdentityFile ~/.ssh/id_ed25519_sk_rk_vps-jeomhps
  IdentityAgent none
  IdentitiesOnly yes

Host vps
  HostName vps.jeomhps.com
  Port 2222
  User admin
  IdentityFile ~/.ssh/id_ed25519_sk_rk_vps-jeomhps
  IdentityAgent none
  IdentitiesOnly yes
